apiVersion: v1
kind: Service
metadata:
  name: {{ include "rapp.fullname" . }}
  labels:
    {{- include "rapp.labels" . | nindent 4 }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ include "rapp.name" . }}
    app.kubernetes.io/instance: {{ .Release.Name }}
  ports:
    - name: http
      port: {{ .Values.service.port }}
      targetPort: {{ .Values.service.port }}
      protocol: TCP
{{- if .Values.service.nodePort }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ include "rapp.fullname" . }}-nodeport
  labels:
    {{- include "rapp.labels" . | nindent 4 }}
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: {{ include "rapp.name" . }}
    app.kubernetes.io/instance: {{ .Release.Name }}
  ports:
    - name: http
      port: {{ .Values.service.port }}
      targetPort: {{ .Values.service.port }}
      nodePort: {{ .Values.service.nodePort }}
      protocol: TCP
{{- end }}
