FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/rapp ./cmd/[[.Name]]

FROM alpine:3.20
RUN addgroup -g 1000 rapp && adduser -D -u 1000 -G rapp rapp
WORKDIR /app
COPY --from=build /out/rapp /app/rapp
USER rapp
EXPOSE 8080
ENTRYPOINT ["/app/rapp"]
